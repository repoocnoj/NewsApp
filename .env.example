# ----- Database -----
# Defaults to SQLite for a zero-config dev experience.
DATABASE_URL="file:./dev.db"

# ----- Auth -----
NEXTAUTH_SECRET="please-change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ----- AI Provider (optional for dev) -----
# Pick one. If neither is set, the app uses a deterministic local mock
# so all AI features still work end-to-end for development/demos.
AI_PROVIDER="mock"          # "mock" | "openai" | "anthropic"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_MODEL=""                 # optional model override

# ----- Ingestion -----
# Set to "1" to attempt live RSS fetching during `npm run ingest`.
# When 0 (default), ingestion falls back to seeded sample articles.
INGEST_LIVE="0"
